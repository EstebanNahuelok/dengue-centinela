# Copiá este archivo a .env y completá los valores.

# Neon: Dashboard > Connection string (usá la "direct connection", no la pooled,
# para evitar lios con prisma migrate durante el hackathon).
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dengue_centinela?sslmode=require"

PORT=3001

# Salt para hashear telefonos, cualquier string sirve para el hackathon.
HASH_SALT=cambia-esto-en-produccion

# https://console.groq.com/keys
GROQ_API_KEY=
# Modelo barato/rapido de Groq, dejalo asi salvo que necesiten mas calidad.
GROQ_MODEL=llama-3.1-8b-instant

# https://console.twilio.com > Account SID / Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero del sandbox de Twilio (el de siempre, mismo para todos los sandboxes)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
