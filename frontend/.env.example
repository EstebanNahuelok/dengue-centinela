# Copiá este archivo a frontend/.env.local (Vite lo lee solo y git lo ignora).
# Tiene que vivir en frontend/, NO en la raiz del monorepo: Vite resuelve los
# .env desde la raiz del proyecto de Vite.

# URL base del backend Express. Sin barra al final.
# Local:  http://localhost:3001
# Render: https://dengue-centinela-api.onrender.com
VITE_API_URL=http://localhost:3001

# true  = el mapa se pinta con src/lib/mock-status.ts (no necesita backend levantado)
# false = pega de verdad a GET /status y POST /recalcular
VITE_USE_MOCK=true
